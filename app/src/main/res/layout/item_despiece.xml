<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@color/bg_card" android:orientation="vertical"
    android:padding="16dp" android:layout_marginBottom="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tvObra"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="@color/text_primary"
            android:textSize="15sp" android:textStyle="bold"
            android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/tvStock"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimary" android:textSize="13sp"
            android:fontFamily="monospace" android:layout_marginStart="8dp"/>
    </LinearLayout>

    <TextView android:id="@+id/tvFecha"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/text_secondary" android:textSize="12sp"
        android:layout_marginTop="4dp"/>
</LinearLayout>
