<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_dark" android:orientation="vertical" android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Inventario físico"
            android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
        <Button android:id="@+id/btnLimpiar"
            android:layout_width="wrap_content" android:layout_height="40dp"
            android:text="Limpiar" style="@style/BtnOutline"
            android:textSize="12sp" android:enabled="false"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="12dp">
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="Escanear producto"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginEnd="8dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etScan"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="text" android:textColor="@color/text_primary"
                android:imeOptions="actionSearch"/>
        </com.google.android.material.textfield.TextInputLayout>
        <Button android:id="@+id/btnScan"
            android:layout_width="56dp" android:layout_height="56dp"
            android:text="→" style="@style/BtnPrimary"/>
    </LinearLayout>

    <TextView android:id="@+id/tvCounter"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/text_secondary" android:textSize="13sp"
        android:layout_marginBottom="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLineas"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"/>

    <Button android:id="@+id/btnConfirmar"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:text="CERRAR INVENTARIO" style="@style/BtnPrimary"
        android:layout_marginTop="12dp" android:enabled="false"/>
</LinearLayout>
